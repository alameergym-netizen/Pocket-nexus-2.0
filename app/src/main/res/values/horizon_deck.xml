<?xml version="1.0" encoding="utf-8"?>
<!-- Nexus Horizon's streaming cards: host, session and network (HorizonStreamDeck). -->
<resources>
    <item name="horizon_deck" type="id"/>
    <item name="horizon_deck_host" type="id"/>
    <item name="horizon_deck_session" type="id"/>
    <item name="horizon_deck_network" type="id"/>

    <string name="horizon_deck_cards">Stream status</string>
    <string name="horizon_deck_host">Host</string>
    <string name="horizon_deck_session">Session</string>
    <string name="horizon_deck_network">Network</string>
    <!-- Read out for a card: its kind, its answer, then the detail -->
    <string name="horizon_deck_card_description">%1$s: %2$s. %3$s</string>
    <!-- Two parts of one line, e.g. "Online · local network" -->
    <string name="horizon_deck_joined">%1$s · %2$s</string>

    <string name="horizon_deck_no_host">No PC paired</string>
    <string name="horizon_deck_pair_hint">Pair a PC in Streaming</string>
    <string name="horizon_deck_online">Online</string>
    <string name="horizon_deck_offline">Offline</string>
    <string name="horizon_deck_not_checked">Not checked yet</string>
    <!-- When the PC last answered, e.g. "Seen 5 minutes ago" -->
    <string name="horizon_deck_seen">Seen %1$s</string>
    <string name="horizon_deck_route_local">local network</string>
    <string name="horizon_deck_route_remote">remote address</string>
    <string name="horizon_deck_route_manual">manual address</string>
    <plurals name="horizon_deck_more_pcs">
        <item quantity="one">%d more PC</item>
        <item quantity="other">%d more PCs</item>
    </plurals>

    <string name="horizon_deck_game_running">A game is running</string>
    <string name="horizon_deck_running_on">On %1$s · select to resume</string>
    <string name="horizon_deck_idle">No stream running</string>
    <string name="horizon_deck_waiting">Waiting for your PCs</string>
    <string name="horizon_deck_last">Last played: %1$s</string>
    <string name="horizon_deck_none_yet">Nothing played yet</string>

    <string name="horizon_deck_wifi">Wi-Fi</string>
    <!-- e.g. "Wi-Fi 5 GHz" -->
    <string name="horizon_deck_wifi_band">Wi-Fi %1$s</string>
    <string name="horizon_deck_wired">Wired</string>
    <string name="horizon_deck_cellular">Mobile data</string>
    <string name="horizon_deck_connected">Connected</string>
    <string name="horizon_deck_no_network">No network</string>
    <string name="horizon_deck_no_network_hint">Select to connect</string>
    <string name="horizon_deck_no_details">No signal details reported</string>
    <string name="horizon_deck_signal">Signal %1$d of 4</string>
    <!-- The radio's link rate as Android reports it; not a measured speed -->
    <string name="horizon_deck_link">%1$d Mbps link</string>
    <string name="horizon_deck_vpn">VPN on</string>
</resources>
