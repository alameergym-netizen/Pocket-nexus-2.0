    <string name="horizon_dsp_title">Nexus stream EQ</string>
    <string name="horizon_dsp_sub">Optional stereo-only software EQ for PC streaming, applied on the next stream. Uses gentle cuts and headroom, not a system-wide equalizer. Bypassed when external audio effects are enabled.</string>
