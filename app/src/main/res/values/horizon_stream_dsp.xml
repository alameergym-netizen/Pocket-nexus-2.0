    <string name="horizon_eq_title">Custom stream equalizer</string>
    <string name="horizon_eq_sub">Adjust four stereo bands, preamp and balance for your next PC stream.</string>
    <string name="horizon_eq_description">Stereo PC streaming uses these cuts when Custom is selected. It reserves 2 dB of headroom. Android external effects take precedence. Edits apply on the next stream.</string>
