<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="pocket_home_headphones">Headphones</string>
    <style name="PocketHomeTool" parent="@android:style/Widget.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/pocket_home_tool_inset</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/pocket_round_icon</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
